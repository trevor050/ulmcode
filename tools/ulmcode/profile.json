{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5#high",
  "update": "disable",
  "plugins": [{ "package": "@ulmcode/operations" }],
  "agents": {
    "small": { "mode": "subagent", "model": "openai/gpt-5.4-mini-fast" },
    "recon": { "mode": "subagent", "model": "openai/gpt-5.4-mini-fast" },
    "evidence": { "mode": "subagent", "model": "openai/gpt-5.4-mini-fast" },
    "report_writer": { "mode": "subagent", "model": "openai/gpt-5.5#high" }
  },
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" }
  ],
  "permissions": [
    { "action": "operation_approve_plan", "resource": "*", "effect": "ask" },
    { "action": "operation_credentials", "resource": "*", "effect": "ask" }
  ]
}
